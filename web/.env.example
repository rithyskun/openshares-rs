# Loopback URL of the Rust API — used by SSR (server components +
# generateMetadata) via src/lib/api-server.ts. In the single-image
# deploy both processes share a container; local dev: run
# `cargo run -p openshares-server` alongside `npm run dev`.
API_INTERNAL_URL=http://127.0.0.1:8080

# Optional SSR fallbacks for src/lib/meta.ts — used only until the API's
# GET /api/meta endpoint answers (the API is authoritative when live).
# NEXT_PUBLIC_SITE_NAME=OpenShares
# NEXT_PUBLIC_APP_URL=http://localhost:3000
