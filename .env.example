# ── Telegram ─────────────────────────────────────────────────────────
BOT_TOKEN=
APP_URL=http://localhost:8080
WEBHOOK_SECRET=

# ── Database ─────────────────────────────────────────────────────────
# Local dev uses a SQLite file; migrations in crates/core/migrations are
# applied at startup via `Db::migrate()`. A libsql/Turso client replaces
# sqlx later if we need to share the production Turso database.
DATABASE_URL=sqlite://data/openshares.db

# ── Media cache ──────────────────────────────────────────────────────
MEDIA_CACHE_DIR=./data/cache
CACHE_TTL_DAYS=7

# ── Server ───────────────────────────────────────────────────────────
PORT=8080

# ── Auth (phase 6 — not used yet) ────────────────────────────────────
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=
# REQUEST_SIGNING_SECRET=
# RSA_PRIVATE_KEY=
# RSA_PUBLIC_KEY=
# ALLOWED_TELEGRAM_IDS=
