# ── Telegram ─────────────────────────────────────────────────────────
BOT_TOKEN=
APP_URL=http://localhost:8080
WEBHOOK_SECRET=

# ── Database ─────────────────────────────────────────────────────────
# Two modes, one code path (libsql):
#   TURSO_DB_URL set   → remote Turso (libsql://*.turso.io), same DB the
#                        TypeScript app used — migrations are already
#                        recorded in its `schema_migrations` table.
#   TURSO_DB_URL unset → local SQLite file at DATABASE_URL.
# Tip: use a second free Turso DB for dev so you don't write to prod.
# TURSO_DB_URL=libsql://your-db-your-org.turso.io
# TURSO_AUTH_TOKEN=
DATABASE_URL=sqlite://data/openshares.db

# ── Media cache ──────────────────────────────────────────────────────
MEDIA_CACHE_DIR=./data/cache
CACHE_TTL_DAYS=7

# ── Server ───────────────────────────────────────────────────────────
PORT=8080
# Next.js page server — axum proxies non-/api traffic here. Empty = API-only.
# Set to http://127.0.0.1:3000 when running `npm run dev`/`start` in web/,
# or leave empty to serve only the API. The Docker image sets it itself.
WEB_ORIGIN=

# ── Auth ─────────────────────────────────────────────────────────────
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=
# REQUEST_SIGNING_SECRET=
# RSA_PRIVATE_KEY=
# RSA_PUBLIC_KEY=
# ALLOWED_TELEGRAM_IDS=
