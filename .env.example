# ── Telegram ─────────────────────────────────────────────────────────
BOT_TOKEN=
APP_URL=http://localhost:8080
WEBHOOK_SECRET=

# ── Database ─────────────────────────────────────────────────────────
# Remote Turso only (libsql://*.turso.io) — required, same as the TS
# app's createClient({url, authToken}). Migrations are already recorded
# in its `schema_migrations` table.
# Tip: use a second free Turso DB for dev so you don't write to prod.
# TURSO_DB_URL=libsql://your-db-your-org.turso.io
# TURSO_AUTH_TOKEN=

# ── Media cache ──────────────────────────────────────────────────────
# fs (default, local dev / bot scripts) or s3 (Cloudflare R2 — the TS
# `MEDIA_CACHE` binding counterpart; also covers audit/ shards).
MEDIA_CACHE_BACKEND=fs
MEDIA_CACHE_DIR=./data/cache
CACHE_TTL_DAYS=7

# S3 backend (required when MEDIA_CACHE_BACKEND=s3 — R2 API token pair +
# bucket; endpoint defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com).
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=openshares-cache
# R2_ENDPOINT=

# ── Server ───────────────────────────────────────────────────────────
PORT=8080
# Next.js page server — axum proxies non-/api traffic here. Empty = API-only.
# Set to http://127.0.0.1:3000 when running `npm run dev`/`start` in web/,
# or leave empty to serve only the API. The Docker image sets it itself.
WEB_ORIGIN=

# Swagger UI at /docs + spec at /docs/openapi.json (opt-in, off by
# default). Requires HTTP Basic credentials — docs won't mount without
# them. dev.sh sets both for you.
# SWAGGER_UI=1
# SWAGGER_AUTH=docs:change-me

# Set to 1 only when a real reverse proxy (cloudflared, nginx) fronts the
# app — it makes rate limits trust cf-connecting-ip / x-forwarded-for.
# Unset, the TCP peer IP is used and those headers can't be spoofed to
# evade login/upload rate limits. compose.yaml sets this to 1 already.
# TRUST_PROXY=1

# ── Auth ─────────────────────────────────────────────────────────────
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=
# REQUEST_SIGNING_SECRET=
# RSA_PRIVATE_KEY=
# RSA_PUBLIC_KEY=
# ALLOWED_TELEGRAM_IDS=
